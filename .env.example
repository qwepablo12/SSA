# Student Success Assistant — environment template.
#
# Copy to `.env` and fill in. Every key below is REQUIRED unless a default is
# shown; a missing key fails at boot with a named error rather than surfacing
# as a None three hours later inside a nightly job (01_Architecture.md §7.5).
#
# Nested settings use a double underscore: SSA_DB__HOST -> settings.db.host

SSA_ENVIRONMENT=local          # local | staging | production
SSA_DEBUG=true

# --- PostgreSQL -------------------------------------------------------------
SSA_DB__HOST=localhost
SSA_DB__PORT=5432
SSA_DB__USER=ssa
SSA_DB__PASSWORD=change-me
SSA_DB__NAME=ssa
SSA_DB__ECHO=false             # log every statement; local debugging only
SSA_DB__POOL_SIZE=10
SSA_DB__MAX_OVERFLOW=5
SSA_DB__POOL_TIMEOUT_SECONDS=10

# --- Test database ----------------------------------------------------------
# Used by the integration suite. MUST be a different database from SSA_DB__NAME:
# the test harness truncates it.
SSA_TEST_DB__HOST=localhost
SSA_TEST_DB__PORT=5432
SSA_TEST_DB__USER=ssa
SSA_TEST_DB__PASSWORD=change-me
SSA_TEST_DB__NAME=ssa_test
